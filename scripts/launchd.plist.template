<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.veda-mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VEDA_ROOT__/.venv/bin/python</string>
    <string>-m</string>
    <string>veda.mcp.server</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__VEDA_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VEDA_HOST</key>
    <string>127.0.0.1</string>
    <key>VEDA_PORT</key>
    <string>8765</string>
    <key>VEDA_TOKEN_FILE</key>
    <string>__VEDA_ROOT__/run/veda-token</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__VEDA_LOG_FILE__</string>
  <key>StandardErrorPath</key>
  <string>__VEDA_LOG_FILE__</string>
</dict>
</plist>
