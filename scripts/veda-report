#!/usr/bin/env bash
# Daily health report emailer.
#   send        run once and email the report now
#   schedule    install a daily 09:00 launchd job (macOS)
#   unschedule  remove the scheduled job
#
# Requires run/veda-mail.env (gitignored) with RESEND_API_KEY,
# VEDA_REPORT_FROM, VEDA_REPORT_TO.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
ROOT="$(pwd)"
LABEL="local.veda-mcp.report"
PLIST="$ROOT/run/$LABEL.plist"
LOG="$HOME/Library/Logs/veda-report.log"

case "${1:-send}" in
  send)
    exec .venv/bin/python scripts/health_report.py
    ;;
  schedule)
    if [[ "$(uname -s)" != "Darwin" ]]; then
      echo "schedule uses launchd (macOS); use cron on other systems:" >&2
      echo "  0 9 * * * cd $ROOT && .venv/bin/python scripts/health_report.py >> ~/veda-report.log 2>&1" >&2
      exit 1
    fi
    mkdir -p "$ROOT/run"
    sed -e "s|__VEDA_ROOT__|$ROOT|g" -e "s|__VEDA_LOG_FILE__|$LOG|g" \
      "$ROOT/scripts/report.launchd.plist.template" > "$PLIST"
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "health report scheduled daily at 09:00 (label $LABEL, log $LOG)"
    ;;
  unschedule)
    if launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null; then
      echo "health report unscheduled"
    else
      echo "health report was not scheduled"
    fi
    ;;
  *)
    echo "usage: scripts/veda-report [send|schedule|unschedule]"
    exit 2
    ;;
esac
